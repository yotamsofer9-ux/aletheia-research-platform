{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aletheia.local/schemas/frame-intensity-0.1.0.json",
  "title": "Aletheia frame-intensity measurement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "methodology_version",
    "prompt_version",
    "case_id",
    "document_id",
    "language",
    "analysis_status",
    "coverage_scope",
    "frame_statement_he",
    "frame_families",
    "frame_cues",
    "components",
    "needs_review"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "methodology_version": {"const": "frame-intensity-v0.1.0"},
    "prompt_version": {"const": "case002-frame-intensity-v0.1.0"},
    "case_id": {"type": "string", "pattern": "^CASE-[0-9]{3}$"},
    "document_id": {"type": "string", "minLength": 1},
    "language": {"enum": ["he", "en", "ar"]},
    "analysis_status": {"enum": ["COMPLETE", "NEEDS_REVIEW"]},
    "coverage_scope": {
      "enum": [
        "FULL_TEXT",
        "TEXTUAL_PAGE_ONLY",
        "TEXT_WITH_VISUAL_EVIDENCE",
        "INCOMPLETE_SOURCE"
      ]
    },
    "frame_statement_he": {"type": "string", "minLength": 1, "maxLength": 320},
    "frame_families": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/frame_family"}
    },
    "frame_cues": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {"$ref": "#/$defs/frame_cue"}
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": ["F1", "F2", "F3", "F4", "F5"],
      "properties": {
        "F1": {"$ref": "#/$defs/component"},
        "F2": {"$ref": "#/$defs/component"},
        "F3": {"$ref": "#/$defs/component"},
        "F4": {"$ref": "#/$defs/component"},
        "F5": {"$ref": "#/$defs/component"}
      }
    },
    "needs_review": {"$ref": "#/$defs/needs_review"}
  },
  "$defs": {
    "frame_family": {
      "enum": [
        "HUMANITARIAN",
        "SECURITY",
        "RESPONSIBILITY",
        "CONFLICT",
        "HUMAN_INTEREST",
        "MORALITY",
        "CONSEQUENCES",
        "INVESTIGATIVE",
        "MEDIA_ACCOUNTABILITY",
        "STRATEGIC",
        "POLITICAL",
        "OTHER"
      ]
    },
    "review_reason": {
      "enum": [
        "SCORE_GAP",
        "SOURCE_VOICE_AMBIGUITY",
        "TRANSLATION_UNCERTAINTY",
        "VISUAL_CONTENT_UNAVAILABLE",
        "EVIDENCE_SPAN_NOT_FOUND",
        "FRAME_FUNCTION_AMBIGUITY",
        "LOW_CONFIDENCE",
        "SOURCE_INCOMPLETE",
        "OTHER"
      ]
    },
    "frame_cue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cue_id",
        "quote_original",
        "location",
        "owner",
        "function",
        "device",
        "reviewer_translation_he"
      ],
      "properties": {
        "cue_id": {"type": "string", "pattern": "^cue_[1-9][0-9]*$"},
        "quote_original": {"type": "string", "minLength": 1, "maxLength": 500},
        "location": {
          "enum": [
            "HEADLINE",
            "SUBHEADLINE",
            "LEAD",
            "BODY",
            "CONCLUSION",
            "VISUAL_CAPTION",
            "TRANSCRIPT"
          ]
        },
        "owner": {
          "enum": [
            "OUTLET",
            "ATTRIBUTED_ACTOR",
            "HEADLINE_SELECTED_QUOTE",
            "UNCLEAR"
          ]
        },
        "function": {
          "enum": [
            "PROBLEM_DEFINITION",
            "AGENCY_CAUSALITY",
            "MORAL_EVALUATION",
            "TREATMENT_DIRECTION",
            "RHETORICAL_REINFORCEMENT"
          ]
        },
        "device": {
          "enum": [
            "PLAIN_ASSERTION",
            "LABEL",
            "METAPHOR",
            "EXEMPLAR",
            "STATISTIC",
            "SOURCE_SELECTION",
            "QUOTE_SELECTION",
            "REPETITION",
            "CONTRAST",
            "VISUAL",
            "OTHER"
          ]
        },
        "reviewer_translation_he": {
          "type": ["string", "null"],
          "maxLength": 700
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score",
        "confidence",
        "rationale_he",
        "evidence_cue_ids",
        "needs_review_reasons"
      ],
      "properties": {
        "score": {"type": "integer", "minimum": 0, "maximum": 4},
        "confidence": {"enum": ["LOW", "MEDIUM", "HIGH"]},
        "rationale_he": {"type": "string", "minLength": 1, "maxLength": 420},
        "evidence_cue_ids": {
          "type": "array",
          "minItems": 0,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^cue_[1-9][0-9]*$"}
        },
        "needs_review_reasons": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/review_reason"}
        }
      }
    },
    "needs_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "reasons", "note_he"],
      "properties": {
        "required": {"type": "boolean"},
        "reasons": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/review_reason"}
        },
        "note_he": {"type": ["string", "null"], "maxLength": 500}
      }
    }
  }
}

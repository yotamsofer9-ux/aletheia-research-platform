# Copy this file to .env and replace every example value locally.
# Never commit .env or a service-account key.

# Google Cloud Platform infrastructure
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account.json

# Vertex AI Settings
VERTEX_AI_MODEL=gemini-2.5-flash

# BigQuery Settings
BQ_DATASET_NORMALIZED=your_normalized_dataset
BQ_DATASET_BILLING=your_billing_dataset

# Google Cloud Storage Settings
GCS_BUCKET_RAW=your-private-raw-data-bucket

# FinOps Settings
# Example only. Set a ceiling that matches the budget attached to your project.
BUDGET_CEILING_USD=25.0

# External APIs (Search & News)
SERPAPI_KEY=your_serpapi_key
NEWSAPI_KEY=your_newsapi_key

# External APIs (Social Feeds & Messaging)
TELEGRAM_API_ID=your_telegram_api_id
TELEGRAM_API_HASH=your_telegram_api_hash
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

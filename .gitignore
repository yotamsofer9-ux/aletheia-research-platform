/scripts/update_static_toc_pages.py
/scripts/build_chapter*.py
/scripts/rebuild_appendix*.py
/scripts/repair_case*.py
/scripts/repair_docx_rtl_word.py
/scripts/repair_seminar*.py
/scripts/merge_case007_snapshot_repair.py
/scripts/add_abstract_and_toc.py
/scripts/add_research_infrastructure_appendix.py
/scripts/audit_docx_rtl_citations.py
/scripts/repair_open_counterevidence_dilemmas.py


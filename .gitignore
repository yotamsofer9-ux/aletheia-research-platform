# ---------------------------------------------------------------------------
# Local research corpus and databases
#
# These folders contain downloaded article text, HTML snapshots, adjudication
# records, SQLite files and other material that is either copyrighted,
# case-specific or too large for the public platform repository.
# ---------------------------------------------------------------------------
/data/
/dataops_blobs/
/dataops_local.db*
/exports/
/output/
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.gz

# Runtime state generated by the Streamlit application
/ui_state.json
/ui_state_v2.json

# Case-generator decisions and reviewed case leads
/case_generator/reviewed_leads/

# Human calibration and case-specific anchor material. Generic policy and
# schemas under anchors/ remain publishable.
/calibration/
/anchors/case*.json
/anchors/case*.jsonl
/anchors/model_reviews/

# ---------------------------------------------------------------------------
# Generated analysis artifacts
#
# Markdown methodology documents remain visible unless explicitly listed
# below. Machine outputs and manuscript assets are kept locally or in the
# approved cloud storage layer.
# ---------------------------------------------------------------------------
# `analysis/` is the local research workspace, not platform source code.
/analysis/

# Cloud receipts describe individual local runs; public table and access
# contracts under cloud/ are not ignored.
/cloud/*receipt*.json
/cloud/m4_access_contract.json

# Locally stored source PDFs and manuscript files
/bibliography/academic_articles/
/bibliography/academic_articles.jsonl
/bibliography/ACADEMIC_ARTICLES_STORAGE.md
/bibliography/NEXUS_*.md
*.docx
*.pdf

# Case-specific rosters belong to the private research workspace. The generic
# multi-case roster remains publishable under config/.
/config/case_rosters/

# Operational history that is useful locally but not part of the public
# platform documentation. These patterns affect untracked files immediately;
# tracked files must be removed from the Git index separately after approval.
/FREEZE_SNAPSHOT*.md
/ANCHOR_AUDIT_CASE*.md
/ANCHOR_REVIEW_CASE*.md
/SAMPLING_MANIFEST_CASE*.md
/SEMINAR_HANDOFF*.md
/DOCUMENTATION_AUDIT*.md
/WRITING_STYLE_PROFILE_HE.md
/HUMAN_DECISIONS.md
/*_REPORT.md
/*_PACKET.md
/CLOUD_MIGRATION.md
/M4_ACCESS_CONTRACT.md
/M4_M5_EXECUTION_PLAN.md
/M5_B01_GATE_RECONCILIATION.md
/STATUS_AND_ROADMAP.md

# Historical CASE-001 pilot configurations are retained locally. Public
# examples live under case_generator/fixtures and the generic discovery frames.
/config/case001_*.json

# Manuscript editing and one-off historical repair utilities are not part of
# the runnable research platform.
/scripts/*seminar*.py
/scripts/edit_round*.py
/scripts/edit_trial_abstract_intro.py
/scripts/format_uniform_reading_docx.py
/scripts/insert_seminar*.py
/scripts/revise_seminar*.py
